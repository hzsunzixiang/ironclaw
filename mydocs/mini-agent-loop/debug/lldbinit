# ============================================================================
# lldbinit — mini-agent-loop attach debug script
# ============================================================================
#
# Usage:
#   1. Start the program:  ./target/debug/mini-agent-loop
#   2. Attach:  lldb -s debug/lldbinit -p $(pgrep mini-agent-loop)
#   3. With log:  lldb -s debug/lldbinit -p $(pgrep mini-agent-loop) 2>&1 | tee debug.log
#   4. Detach:  (lldb) detach
#
# All breakpoints auto-continue (handlers return False).
# Debug output goes to LLDB terminal only.
# ============================================================================

# ── Settings ──
settings set auto-confirm true
settings set target.process.thread.step-avoid-regexp ""
settings set target.max-children-count 256

# ── Load Rust pretty printers (same as rust-lldb) ──
# This enables proper formatting for String, Vec, HashMap, etc.
script import subprocess; sysroot = subprocess.check_output(["rustc", "--print", "sysroot"]).decode().strip(); lldb.debugger.HandleCommand('command script import "' + sysroot + '/lib/rustlib/etc/lldb_lookup.py"'); lldb.debugger.HandleCommand('command source "' + sysroot + '/lib/rustlib/etc/lldb_commands"')

# ── Load Python helpers ──
command script import debug/lldb_helpers.py

# ── BP1: User input captured — main.rs:164 ──
breakpoint set --file main.rs --line 164
breakpoint command add -F lldb_helpers.bp1_user_input

# ── BP2: Build conversation context — main.rs:189 ──
breakpoint set --file main.rs --line 189
breakpoint command add -F lldb_helpers.bp2_build_messages

# ── BP3: Enter agentic loop — main.rs:192 ──
breakpoint set --file main.rs --line 192
breakpoint command add -F lldb_helpers.bp3_enter_loop

# ── BP4: run_agentic_loop entry — agent.rs:68 ──
breakpoint set --file agent.rs --line 68
breakpoint command add -F lldb_helpers.bp4_loop_entry

# ── BP5: Before LLM call — agent.rs:75 ──
breakpoint set --file agent.rs --line 75
breakpoint command add -F lldb_helpers.bp5_before_llm

# ── BP6: After LLM response — agent.rs:77 ──
breakpoint set --file agent.rs --line 77
breakpoint command add -F lldb_helpers.bp6_llm_response

# ── BP7: Text response branch — agent.rs:80 ──
breakpoint set --file agent.rs --line 80
breakpoint command add -F lldb_helpers.bp7_text_response

# ── BP8: Tool calls branch — agent.rs:89 ──
breakpoint set --file agent.rs --line 89
breakpoint command add -F lldb_helpers.bp8_tool_calls

# ── BP9: execute_tool_with_safety — tool execution ──
breakpoint set --name mini_agent_loop::tools::execute_tool_with_safety
breakpoint command add -F lldb_helpers.bp9_tool_exec

# ── BP10: process_tool_result — tool result ──
breakpoint set --name mini_agent_loop::tools::process_tool_result
breakpoint command add -F lldb_helpers.bp10_tool_result

# ── BP11: Calculator execute — calculator.rs:48 ──
breakpoint set --file calculator.rs --line 48
breakpoint command add -F lldb_helpers.bp11_calculator

# ── BP12: OpenAI chat() request — openai.rs:275 ──
breakpoint set --file openai.rs --line 275
breakpoint command add -F lldb_helpers.bp12_openai_chat

# ── BP13: OpenAI response parsing — openai.rs:306 ──
breakpoint set --file openai.rs --line 306
breakpoint command add -F lldb_helpers.bp13_openai_parse

# ── BP14: Loop outcome — main.rs:193 ──
breakpoint set --file main.rs --line 193
breakpoint command add -F lldb_helpers.bp14_final

# ── Summary ──
breakpoint list --brief

# ── Auto-resume the attached process ──
continue
