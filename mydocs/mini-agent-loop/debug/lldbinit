# ============================================================================
# lldbinit — mini-agent-loop attach debug script (pure LLDB, no Python)
# ============================================================================
#
# All debug output goes to the LLDB terminal only, NOT into the target
# process's stdout/stderr. This means debug info will NOT pollute the
# application's normal output.
#
# Key: we use `script print(...)` (lldb-side output) instead of
#      `expression (void)printf(...)` (target-process-side output).
#
# Usage:
#   1. Start the program normally:
#        ./target/debug/mini-agent-loop
#
#   2. Attach and load breakpoints (from project root):
#        lldb -s debug/lldbinit -p $(pgrep mini-agent-loop)
#
#      Or with rust-lldb:
#        rust-lldb -s debug/lldbinit -p $(pgrep mini-agent-loop)
#
#   3. Output goes directly to your lldb terminal (not the app's terminal).
#      Redirect as you wish:
#        lldb -s debug/lldbinit -p $(pgrep mini-agent-loop) 2>&1 | tee debug.log
#
#   4. To detach without killing the process:
#        (lldb) detach
#
# All breakpoints auto-continue. The program runs normally with
# debug info printed at each key point in the agent loop.
# ============================================================================


# ── Settings ──
settings set auto-confirm true
settings set target.process.thread.step-avoid-regexp ""
settings set target.max-children-count 256


# ── BP1: User input captured — main.rs:164 ──
breakpoint set --file main.rs --line 164
breakpoint command add
  script print("\n" + "=" * 60 + "\n[BP1: USER INPUT  (main.rs:164)]\n" + "=" * 60)
  frame variable input
  script print("=" * 60 + "\n")
  continue
DONE

